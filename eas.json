{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "env": {
        "EXPO_PUBLIC_AD_MODE": "test"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "play-internal": {
      "env": {
        "EXPO_PUBLIC_AD_MODE": "production"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "closed-testing": {
      "env": {
        "EXPO_PUBLIC_AD_MODE": "production"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_AD_MODE": "production"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "closed-testing": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
